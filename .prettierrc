{
  "semi": true,
  "singleQuote": true,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "printWidth": 128,
  "useTabs": false,
  "tabWidth": 2,
  "endOfLine": "auto",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "jsxBracketSameLine": false,
  "arrowParens": "always",
  "singleAttributePerLine": true,
  "jsxSingleQuote": false
}
